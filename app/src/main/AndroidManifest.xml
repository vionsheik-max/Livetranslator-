<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:name=".LiveTranslateApplication"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiveTranslate">
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity-alias android:name=".LauncherMist" android:enabled="true" android:exported="true" android:icon="@drawable/ic_launcher_mist" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherOcean" android:enabled="false" android:exported="true" android:icon="@drawable/ic_launcher_ocean" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherLavender" android:enabled="false" android:exported="true" android:icon="@drawable/ic_launcher_lavender" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherSage" android:enabled="false" android:exported="true" android:icon="@drawable/ic_launcher_sage" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherWarmSand" android:enabled="false" android:exported="true" android:icon="@drawable/ic_launcher_warm_sand" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherMidnight" android:enabled="false" android:exported="true" android:icon="@drawable/ic_launcher_midnight" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>

        <service
            android:name=".service.LiveTranslateOverlayService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />
        <service
            android:name=".service.VoiceInterpreterService"
            android:foregroundServiceType="microphone"
            android:exported="false" />
    </application>

</manifest>
